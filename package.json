{
  "name": "stallhub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "concurrently \"nodemon src/server.js\" \"npm run dev --prefix client\"",
    "start": "node src/server.js",
    "build": "npm run build --prefix client",
    "server": "nodemon src/server.js",
    "client": "npm run dev --prefix client"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "nodemon": "^3.1.10"
  }
}
