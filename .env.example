# Supabase PostgreSQL Session Pooler URI (port 5432). Keep actual .env private.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Use a unique random secret of 32+ characters.
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Initial platform administrator. Set a unique strong password (12+ chars).
SUPER_ADMIN_NAME="Platform Administrator"
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="ChangeThisPassword123!"

PORT=5000
NODE_ENV=development
FRONTEND_URL="https://foodstallhub-sd2hqv.v2.appdeploy.ai"
PUBLIC_MENU_BASE_URL="https://foodstallhub-sd2hqv.v2.appdeploy.ai"
DB_POOL_MAX=5
